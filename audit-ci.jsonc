{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // audit-ci supports reading JSON, JSONC, and JSON5 config files.
  // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
  "moderate": true,
  "allowlist": [ // NOTE: Please add as much information as possible to any items added to the allowList
    {
      "GHSA-g8qq-57p8-ggw5": {
        "active": true,
        "notes": "sanitize-html <=2.17.6, moderate: stored XSS via SVG SMIL URI-list scheme-policy bypass. Held at 2.17.5 at the root and under shins: 2.17.6+ (including the 2.18.0 fix) pulls ESM-only htmlparser2 12, which jest 29 (pinned in .ncurc.yaml) cannot load, so every unit suite fails at require('@mojaloop/central-services-shared'). Reachable at runtime: src/plugins.js registers the central-services-shared APIDocumentation plugin at startup when API_DOC_ENDPOINTS_ENABLED is on, the default in config/default.json, and that plugin renders the docs through widdershins and shins. Its only input is the service's own OpenAPI document (openAPIBackend.document), never request data. Move to sanitize-html 2.18 once jest 30 is unblocked.",
        "expiry": "2027-01-31"
      }
    },
    {
      "GHSA-jxwj-j7wr-gfrw": {
        "active": true,
        "notes": "sanitize-html <=2.17.5, moderate: mutation XSS / allowedTags bypass via a literal </textarea/> solidus close. Held at 2.17.5 at the root and under shins: 2.17.6+ (including the 2.18.0 fix) pulls ESM-only htmlparser2 12, which jest 29 (pinned in .ncurc.yaml) cannot load, so every unit suite fails at require('@mojaloop/central-services-shared'). Reachable at runtime: src/plugins.js registers the central-services-shared APIDocumentation plugin at startup when API_DOC_ENDPOINTS_ENABLED is on, the default in config/default.json, and that plugin renders the docs through widdershins and shins. Its only input is the service's own OpenAPI document (openAPIBackend.document), never request data. Move to sanitize-html 2.18 once jest 30 is unblocked.",
        "expiry": "2027-01-31"
      }
